DATABASE_URL=postgres://postgres:mypassword@localhost:5432/travel_mgr
SECRET=your-secret-key-here
PORT=3001

# Allowed CORS origins (comma-separated) — required in production
# Example: https://travel-manager.vercel.app,https://www.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Also allow Origin suffixes *.vercel.app and *.onrender.com (default: true).
# Set to false for locked-down / multi-tenant deployments.
# CORS_ALLOW_HOSTED_SUFFIXES=false

# Test database (CI and local tests)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/travel_mgr_test

# Integration-test fixture password (never use in production)
TEST_USER_PASSWORD=test-fixture-credential

# Optional AI
USE_OPENAI=false
OPENAI_API_KEY=your-openai-api-key-here
# OpenAI model for planning (e.g. gpt-4o-mini, gpt-4o)
OPENAI_MODEL=gpt-4o-mini

# Frontend URL (password-reset email links)
FRONTEND_URL=http://localhost:5173

# Public registration (disabled by default when NODE_ENV=production)
# ALLOW_REGISTRATION=true

# Demo read-only user password (created by migration if the account is missing).
# Local/test default when unset: DemoUser1!
# Production: REQUIRED to seed demo — without it, the demo user is not created.
# DEMO_USER_PASSWORD=change-me-in-production

# Optional SMTP (without config, reset emails are logged without the message body)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@example.com
