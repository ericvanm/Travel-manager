DATABASE_URL=postgres://postgres:mypassword@localhost:5432/travel_mgr
SECRET=your-secret-key-here
PORT=3001

# Origines autorisées (séparées par des virgules) — requis en production
# Ex. https://travel-manager.vercel.app,https://www.mondomaine.com
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Base de données de test (CI et tests locaux)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/travel_mgr_test

# IA Configuration (optionnel)
USE_OPENAI=false
OPENAI_API_KEY=your-openai-api-key-here
# Modèle OpenAI pour la planification (ex. gpt-4o-mini, gpt-4o)
OPENAI_MODEL=gpt-4o-mini

# URL du frontend (liens de réinitialisation mot de passe)
FRONTEND_URL=http://localhost:5173

# Inscription publique (désactivée par défaut en production)
# ALLOW_REGISTRATION=true

# SMTP (optionnel — sans config, les e-mails de reset sont loggés sans le corps du message)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@example.com