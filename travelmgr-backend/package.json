{
  "name": "travel-manager-backend",
  "version": "1.0.0",
  "description": "Travel Manager Backend API",
  "main": "index.js",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "cross-env NODE_ENV=development nodemon index.js",
    "lint": "eslint . --max-warnings 0",
    "lint:report": "eslint . --max-warnings 0 --format json --output-file eslint-report.json",
    "test": "cross-env NODE_ENV=test node --test --test-concurrency=1 tests/",
    "test:coverage": "node -e \"require('node:fs').mkdirSync('coverage',{recursive:true})\" && cross-env NODE_ENV=test node --test --experimental-test-coverage --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=./coverage/lcov.info --test-concurrency=1 tests/",
    "start:test": "cross-env NODE_ENV=test node index.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "openai": "^4.77.0",
    "pg": "^8.22.0",
    "sequelize": "^6.37.8",
    "tesseract.js": "^5.1.0",
    "umzug": "^3.8.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin-js": "^1.6.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
