{
  "compilerOptions": {
    "target": "es2017",
    "outDir": "./build/",
    "lib": ["dom", "es2017"],
    "module": "commonjs",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
